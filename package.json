{
  "name": "database-viewer",
  "version": "0.1.0",
  "description": "VS Code extension for viewing and querying databases",
  "main": "dist/extension.js",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onView:databaseViewer.connections"
  ],
  "contributes": {
    "commands": [
      {
        "command": "databaseViewer.addConnection",
        "title": "Add Database Connection"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "database-viewer",
          "title": "Database Viewer",
          "icon": "media/db-icon.svg"
        }
      ]
    },
    "views": {
      "database-viewer": [
        {
          "id": "databaseViewer.connections",
          "name": "Connections"
        }
      ]
    }
  },
  "scripts": {
    "dev": "npm run build:extension -- --watch",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "node esbuild.js",
    "build:webview": "vite build",
    "lint": "eslint src/",
    "package": "vsce package",
    "test": "echo \"No tests yet\""
  },
  "dependencies": {
    "ag-grid-community": "^33.0.0",
    "ag-grid-react": "^33.0.0",
    "better-sqlite3": "^11.0.0",
    "monaco-editor": "^0.50.0",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "esbuild": "^0.19.11",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.7",
    "vsce": "^2.15.0",
    "vitest": "^1.0.4"
  }
}
